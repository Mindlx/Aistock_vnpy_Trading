# 融合系统 gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# API Keys & Secrets
.env
.env.*
# 但 .env.example 需要追踪
!.env.example

# IDE & Tooling
.idea/
.vscode/
.claude/
.omo/

# Fusion runtime data
data/fusion_output/
data/lynx/
data/mindlynx/
data/tradingagent/
data/cache/
data/realtime/
data/unified_cache/

# System runtime data (not tracked)
systems/MindLynx-Aistock/data/
systems/MindLynx-Aistock/logs/

# mind_TradingAgent runtime (user home)
.mind_tradingagent/

# Temporary
*.log
*.tmp
systems/*/.venv
systems/lynx_vnpy/lynx_env

# Backtest runtime data (auto-generated)
data/backtest/

# ML factor learning / LGB artifacts
data/vnpy_lab/
data/vnpy_alpha_tmp/
data/stock_analysis.db

# Generated reports
reports/

# Data warehouse runtime (auto-generated)
data/data_warehouse.db*

# Runtime logs (auto-generated)
config/logs/fusion_history.csv

# Backup files
*.bak
.env.secrets
data/stock_analysis.db-shm
data/stock_analysis.db-wal
*.db-shm
*.db-wal
systems/MindLynx-Aistock/data/stock_analysis.db
systems/MindLynx-Aistock/.env
