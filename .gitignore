# 融合系统 gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# API Keys & Secrets
.env
.env.*
# 但 .env.example 需要追踪
!.env.example

# IDE & Tooling
.idea/
.vscode/
.claude/
.omo/
.gitnexus/

# Runtime Data
config/logs/
data/fusion_output/
data/lynx/
data/mindlynx/
data/tradingagent/

# System runtime data (not tracked)
systems/MindLynx-Aistock/data/

# mind_TradingAgent runtime (user home)
.mind_tradingagent/

# Temporary
*.log
*.tmp
