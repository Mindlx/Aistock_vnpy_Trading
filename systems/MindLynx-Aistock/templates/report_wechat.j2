{% set parts = parts + [result.sentiment_score|string + '分 ' + e.signal_text] %}
{% if core.get('one_sentence') %}{% set parts = parts + [core.one_sentence[:60]|string] %}{% elif result.analysis_summary %}{% set parts = parts + [result.analysis_summary[:60]|string] %}{% endif %}
{% if sniper.get('stop_loss') %}{% set parts = parts + ['止损' + sniper.stop_loss|string] %}{% endif %}
