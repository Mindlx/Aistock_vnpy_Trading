# ===================================
# A股自选股智能分析系统 - 环境变量
# ===================================

# 自选股列表
STOCK_LIST=001390,300652,600372,605368,000592,603189,603557,688202,601801,300676

# 分组分析（同板块内做横截面对比，提高因子 z-score 可靠性）
# Group 1: 制造/科技
STOCK_GROUP_1=001390,300652,600372,603189
# Group 2: 消费/医药/能源
STOCK_GROUP_2=605368,000592,603557,688202,300676
# Group 3: 文化传媒
STOCK_GROUP_3=601801

# ===================================
# AI 模型配置 - DeepSeek
# ===================================
# 分级模型: 日常分析用 v4-flash (高性价比), Agent 深度推理用 v4-pro
# v4-flash: $0.14/M input, 缓存命中 $0.0028/M
# v4-pro:   $0.435/M input, 缓存命中 $0.003625/M (约3倍价差, 适合复杂推理)
LLM_CHANNELS=deepseek
LLM_DEEPSEEK_PROTOCOL=deepseek
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_API_KEY=sk-953d2d0d6c3a415cb88ab0fae3b6739b
LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
LITELLM_MODEL=deepseek/deepseek-v4-flash
AGENT_LITELLM_MODEL=deepseek/deepseek-v4-flash
LLM_TEMPERATURE=0.3

# ===================================
# 搜索引擎配置（可选）
# ===================================
# BOCHA_API_KEYS=
# TAVILY_API_KEYS=
# SERPAPI_API_KEYS=
TUSHARE_TOKEN=e06a85d89e62c7cc844270c5f6d4c52562f30e6eb7948b5dec4416b7
# TAVILY_API_KEYS=  # 已移除：额度用完，改用 EastMoney(免费)+SearXNG
SEARXNG_BASE_URLS=http://localhost:8081
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
NEWS_STRATEGY_PROFILE=short

# ===================================
# 通知渠道 - 企业微信群机器人
# ===================================
# 周末情报告警推送渠道（重要性≥7的事件）
NOTIFICATION_ALERT_CHANNELS=wechat
MARKET_REVIEW_ENABLED=true
REPORT_TYPE=full
REPORT_LANGUAGE=zh

# ===================================
# 定时任务
# ===================================
SCHEDULE_ENABLED=true
SCHEDULE_TIME=23:59
RUN_IMMEDIATELY=true

# ===================================
# 分析配置
# ===================================
MAX_WORKERS=6
LOG_DIR=./logs
LOG_LEVEL=INFO
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=20
AGENT_MODE=true
AGENT_ARCH=single
AGENT_SKILLS=bull_trend,volume_breakout,event_driven,ma_golden_cross,shrink_pullback,bottom_volume
AGENT_SKILL_AUTOWEIGHT=true
AGENT_MEMORY_ENABLED=true
AGENT_SKILL_COMPACT=true
EVENT_MONITOR_ENABLED=true
AGENT_EVENT_MONITOR_ENABLED=true
WEBUI_ENABLED=false
USE_PROXY=false

# === WebSocket 实时行情 ===
WEBSOCKET_REALTIME_ENABLED=true
# 启用 WebSocket 长连接获取实时行情，零成本免费数据源
# === 推送渠道 ===
# 企业微信群机器人
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=2eb957ab-bc5b-4f99-8db9-b0fcb20ad44f
# PushPlus（国内免费，微信公众号推送）
# PUSHPLUS_TOKEN=39ad371a750747a0b8a9bffe90492935
# PUSHPLUS_TOPIC=  # 可选：群组编码，实现一对多推送

# === 个性化设置 ===
# PORTFOLIO_MONTHLY_INVESTMENT=5000  # 月定投金额，启用后在报告中显示个性化风险翻译

# === 显示设置 ===
REPORT_RENDERER_ENABLED=false
# 大盘复盘颜色：red_up=红涨绿跌（国内习惯）, green_up=绿涨红跌（美式习惯）
MARKET_REVIEW_COLOR_SCHEME=red_up

# === 筹码分布 ===
# Tushare免费版 cyq_chips 限制10次/小时，8只股票瞬间超限；关闭后依赖支撑/压力位模块
ENABLE_CHIP_DISTRIBUTION=false
MD2IMG_ENGINE=wkhtmltoimage
\n# Supermemory persistent memory (open-code plugin)\nSUPERMEMORY_API_KEY=sm_rx1PRZo2h7zEBMGgEiCCxv_b8n7Odu0ft36sV8eCsp0pdIUNzBcWexDfszDdXrhrk9flH1DeEdh9vQTmFB9JYbL

# TickFlow API Key (大盘复盘数据源)
TICKFLOW_API_KEY=tk_fec1a9f726cc4773b1bf12f9077da6eb

# 避免启动时全量分析导致 OOM
SCHEDULE_RUN_IMMEDIATELY=false

# Morph MCP remote tools
MORPH_API_KEY=sk-QvL69CvnCBg-zkraS_eVKfxZkZokJmX4ABEcYKFx8ieQU9fB
ENABLE_EASTMONEY_PATCH=true
REALTIME_SOURCE_PRIORITY=tencent,efinance,akshare_em,akshare_sina,tushare

# 基本面管道超时配置（解决资金流板块排名调用在子线程中耗时过长的问题）
FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=60
FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=30
