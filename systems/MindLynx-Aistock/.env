# ===================================
# A股自选股智能分析系统 - 环境变量
# ===================================

# 自选股列表
STOCK_LIST=001390,300652,600372,605368,000592,603189,603557,688202,601801,300676,603127,000999,301293,301106,002230,000988,000060,605117

# 分组分析（同板块内做横截面对比，提高因子 z-score 可靠性）
# Group 1: 制造/科技
STOCK_GROUP_1=001390,300652,600372,603189
# Group 2: 消费/医药/能源
STOCK_GROUP_2=605368,000592,603557,688202,300676
# Group 3: 文化传媒
STOCK_GROUP_3=601801,301293,301106,002230,000988,000060,605117

# ===================================
# AI 模型配置 - DeepSeek
# ===================================
# 分级模型: 日常分析用 v4-flash (高性价比), Agent 深度推理用 v4-pro
# v4-flash: $0.14/M input, 缓存命中 $0.0028/M
# v4-pro:   $0.435/M input, 缓存命中 $0.003625/M (约3倍价差, 适合复杂推理)
LLM_CHANNELS=qwen36
LLM_DEEPSEEK_PROTOCOL=
LLM_DEEPSEEK_BASE_URL=
# LLM_DEEPSEEK_API_KEY 从 ~/.secrets 加载（优先级高于 .env）
# LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODELS=
LITELLM_MODEL=openai/deepseek-v4-flash
AGENT_LITELLM_MODEL=openai/deepseek-v4-flash
LLM_TEMPERATURE=0.3

# ===================================
# 搜索引擎配置（可选）
# ===================================
# BOCHA_API_KEYS=
# TAVILY_API_KEYS=
# SERPAPI_API_KEYS=
# TUSHARE_TOKEN= (from ~/.secrets)e06a85d89e62c7cc844270c5f6d4c52562f30e6eb7948b5dec4416b7
# TAVILY_API_KEYS=  # 已移除：额度用完，改用 EastMoney(免费)+SearXNG
SEARXNG_BASE_URLS=http://localhost:8081
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
NEWS_STRATEGY_PROFILE=ultra_short

# ===================================
# 通知渠道 - 关闭（通过 Hermes 推送）
# ===================================
# 周末情报告警推送渠道（重要性≥7的事件）
NOTIFICATION_ALERT_CHANNELS=wechat
MARKET_REVIEW_ENABLED=true
REPORT_TYPE=full
REPORT_LANGUAGE=zh

# ===================================
# 定时任务
# ===================================
SCHEDULE_ENABLED=true
SCHEDULE_TIME=23:59
RUN_IMMEDIATELY=true

# ===================================
# 分析配置
# ===================================
MAX_WORKERS=6
LOG_DIR=./logs
LOG_LEVEL=INFO
BACKTEST_ENABLED=true
BACKTEST_EVAL_WINDOW_DAYS=20
AGENT_MODE=true
AGENT_ARCH=single
AGENT_SKILLS=bull_trend,volume_breakout,event_driven,ma_golden_cross,shrink_pullback,bottom_volume
AGENT_SKILL_AUTOWEIGHT=true
AGENT_MEMORY_ENABLED=true
AGENT_SKILL_COMPACT=false
WEBUI_ENABLED=false
USE_PROXY=false

# === WebSocket 实时行情 ===
# 启用 WebSocket 长连接获取实时行情，零成本免费数据源
# === 推送渠道（企业微信 Webhook 统一在项目根 .env 维护） ===
# PushPlus（国内免费，微信公众号推送）
# 当前推送由 Hermes cron 处理，此通道注释备用
# PUSHPLUS_TOKEN=39ad371a750747a0b8a9bffe90492935
# PUSHPLUS_TOPIC=  # 可选：群组编码，实现一对多推送

# === 个性化设置 ===
# PORTFOLIO_MONTHLY_INVESTMENT=5000  # 月定投金额，启用后在报告中显示个性化风险翻译

# === 显示设置 ===
REPORT_RENDERER_ENABLED=true
# 大盘复盘颜色：red_up=红涨绿跌（国内习惯）, green_up=绿涨红跌（美式习惯）
MARKET_REVIEW_COLOR_SCHEME=red_up

# === 筹码分布 ===
# Tushare免费版 cyq_chips 限制10次/小时，8只股票瞬间超限；关闭后依赖支撑/压力位模块
ENABLE_CHIP_DISTRIBUTION=false
MD2IMG_ENGINE=wkhtmltoimage
\n# Supermemory persistent memory (open-code plugin)\nSUPERMEMORY_API_KEY=sm_rx1PRZo2h7zEBMGgEiCCxv_b8n7Odu0ft36sV8eCsp0pdIUNzBcWexDfszDdXrhrk9flH1DeEdh9vQTmFB9JYbL

# TickFlow API Key (大盘复盘数据源)
# TICKFLOW_API_KEY= (from ~/.secrets)tk_fec1a9f726cc4773b1bf12f9077da6eb

# 避免启动时全量分析导致 OOM
SCHEDULE_RUN_IMMEDIATELY=false

# Morph MCP remote tools
MORPH_API_KEY=sk-QvL69CvnCBg-zkraS_eVKfxZkZokJmX4ABEcYKFx8ieQU9fB
VISION_MODEL=
LLM_QWEN36_PROTOCOL=openai
LLM_QWEN36_BASE_URL=http://localhost:11434/v1
LLM_QWEN36_ENABLED=true
LLM_QWEN36_API_KEY=Qwen3.6-27b-gpu0
LLM_QWEN36_API_KEYS=
LLM_QWEN36_MODELS=deepseek-v4-flash,/models/Qwen3.6-27B-UD-Q4_K_XL.gguf
LLM_DEEPSEEK_ENABLED=
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_API_KEYS=
LLM_DEEPSEEK_EXTRA_HEADERS=
LITELLM_FALLBACK_MODELS=openai//models/Qwen3.6-27B-UD-Q4_K_XL.gguf
AGENT_CONTEXT_COMPRESSION_ENABLED=true
