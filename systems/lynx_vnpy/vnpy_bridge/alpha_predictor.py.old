#!/usr/bin/env python3
"""
Alpha+LGB 推理模块 — 为 lynx_signal.py 提供Alpha158+LGB信号

用法:
    from vnpy_bridge.alpha_predictor import AlphaPredictor
    predictor = AlphaPredictor()
    prob_up = predictor.predict(code, df)  # df是pandas DataFrame
"""

import logging
import sys
from pathlib import Path

import numpy as np
import pandas as pd
import polars as pl

_SCRIPT_DIR = Path(__file__).resolve().parent
_PROJECT_ROOT = _SCRIPT_DIR.parent.parent.parent
sys.path.insert(0, str(_PROJECT_ROOT))
sys.path.insert(0, str(_SCRIPT_DIR.parent / "lynx_vnpy"))

from lynx_vnpy.trader.object import BarData
from lynx_vnpy.trader.constant import Exchange, Interval
from lynx_vnpy.alpha.dataset.datasets.alpha_158 import Alpha158
from lynx_vnpy.alpha.dataset.processor import process_drop_na, process_cs_norm
from lynx_vnpy.alpha.lab import AlphaLab

logger = logging.getLogger(__name__)

EXCHANGE_MAP = {
    p: Exchange.SSE if p in ("6", "5", "9", "7") else Exchange.SZSE
    for p in ("6", "5", "9", "7", "0", "3", "2")
}


class AlphaPredictor:
    """Alpha158 + LGB 预测器"""

    def __init__(self, model_path: str | None = None):
        import lightgbm as lgb
        if model_path is None:
            model_path = str(_PROJECT_ROOT / "systems/lynx_vnpy/models/alpha_lgb_model.txt")
        self.model_path = model_path
        self._model = lgb.Booster(model_file=model_path)
        logger.info(f"AlphaPredictor loaded: {model_path}")

    def _df_to_bars(self, df: pd.DataFrame, code: str) -> list[BarData]:
        """pandas df → vnpy BarData"""
        prefix = code[0]
        exchange = Exchange.SSE if prefix in ("6", "5", "9", "7") else Exchange.SZSE
        bars = []
        for _, row in df.iterrows():
            bars.append(BarData(
                symbol=code, exchange=exchange,
                datetime=pd.Timestamp(row.get("日期", row.get("date"))).to_pydatetime(),
                interval=Interval.DAILY,
                open_price=float(row.get("开盘", row.get("open", 0))),
                high_price=float(row.get("最高", row.get("high", 0))),
                low_price=float(row.get("最低", row.get("low", 0))),
                close_price=float(row.get("收盘", row.get("close", 0))),
                volume=float(row.get("成交量", row.get("volume", 0))),
                turnover=float(row.get("成交额", row.get("amount", 0))),
                gateway_name="ALPHA",
            ))
        return bars

    def predict(self, df: pd.DataFrame, code: str) -> float | None:
        """返回上涨概率 prob_up (0~1), None表示失败"""
        try:
            # 1. 转换为BarData并保存到临时AlphaLab
            bars = self._df_to_bars(df, code)
            lab = AlphaLab(str(_PROJECT_ROOT / "data/vnpy_alpha_tmp"))
            lab.save_bar_data(bars)

            # 2. 加载为Polars DataFrame
            dates = [b.datetime for b in bars]
            start = str(dates[0].date()) if dates else "2020-01-01"
            end = str(dates[-1].date()) if dates else "2020-01-01"
            vt_symbol = f"{code}.{exchange_to_str(bars[0].exchange)}"
            pdf = lab.load_bar_df([vt_symbol], Interval.DAILY, start, end, extended_days=0)
            if pdf is None or len(pdf) == 0:
                return None

            # 3. 构建Alpha158数据集（只需要推理，不需要训练/验证分割）
            tmp_end = str(dates[-1].date())
            dataset = Alpha158(
                pdf,
                train_period=(start, tmp_end),
                valid_period=(tmp_end, tmp_end),
                test_period=(tmp_end, tmp_end),
            )
            dataset.prepare_data()

            # 4. 提取最新一行因子值
            result_df = dataset.result_df
            result_df = process_drop_na(result_df)
            result_df = process_cs_norm(result_df, method="robust")

            # 取最新一行
            last_row = result_df.tail(1)
            if last_row.is_empty():
                return None

            # 5. 预测
            features = last_row.select(last_row.columns[2:-1]).to_pandas()  # 跳过datetime, vt_symbol, label
            prob_up = self._model.predict(features.values)[0]
            return float(prob_up)

        except Exception as e:
            logger.warning(f"AlphaPredictor failed for {code}: {e}")
            return None


def exchange_to_str(exch: Exchange) -> str:
    return "SSE" if exch == Exchange.SSE else "SZSE"
