# Aistock_vnpy_Trading 环境变量配置
# 复制此文件为 .env 并根据需要修改

# ── 企业微信推送（可选） ──
# 在群机器人 Webhook 地址中获取
# 所有子系统统一从此配置，不要在各子系统单独设置
#   Fusion(wecom_notifier) + lynx_signal: WECOM_WEBHOOK_URL
#   MindLynx(wechat_sender):            WECHAT_WEBHOOK_URL（别名，同一值）
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# ── mind_TradingAgent LLM API（可选） ──
# DeepSeek（推荐）
DEEPSEEK_API_KEY=sk-your-key-here
# 或 OpenAI
# OPENAI_API_KEY=sk-your-key-here
