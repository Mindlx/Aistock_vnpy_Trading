[Unit]
Description=Aistock_vnpy_Trading — c1test 全面回测（每周日）
Documentation=https://github.com/Mindlx/Aistock_vnpy_Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/bluekuma/workspace/Aistock_vnpy_Trading
ExecStart=/home/bluekuma/workspace/Aistock_vnpy_Trading/.venv/bin/python scripts/c1test.py --full
StandardOutput=journal
StandardError=journal
TimeoutStopSec=600

[Install]
WantedBy=default.target
