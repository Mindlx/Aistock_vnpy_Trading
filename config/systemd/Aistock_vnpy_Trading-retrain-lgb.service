[Unit]
Description=Aistock_vnpy_Trading — LGB + RF 模型自动重训（随 15:15 量化信号后）
Documentation=https://github.com/Mindlx/Aistock_vnpy_Trading
After=network-online.target Aistock_vnpy_Trading-lynx-signal.service

[Service]
Type=oneshot
WorkingDirectory=/home/bluekuma/workspace/Aistock_vnpy_Trading
ExecStart=/home/bluekuma/workspace/Aistock_vnpy_Trading/.venv/bin/python systems/lynx_vnpy/vnpy_bridge/retrain_lgb.py
ExecStart=/home/bluekuma/workspace/Aistock_vnpy_Trading/.venv/bin/python systems/lynx_vnpy/vnpy_bridge/retrain_rf.py
StandardOutput=journal
StandardError=journal
TimeoutStopSec=300

[Install]
WantedBy=default.target
