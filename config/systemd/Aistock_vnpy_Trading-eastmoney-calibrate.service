[Unit]
Description=Aistock_vnpy_Trading — 东方财富评级 w/f 阈值校准（每月）
Documentation=https://github.com/Mindlx/Aistock_vnpy_Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 法定节假日门禁 (普通周末照常运行)
ExecCondition=/home/bluekuma/workspace/Aistock_vnpy_Trading/.venv/bin/python /home/bluekuma/workspace/Aistock_vnpy_Trading/scripts/holiday_gate.py
WorkingDirectory=/home/bluekuma/workspace/Aistock_vnpy_Trading
ExecStart=/home/bluekuma/workspace/Aistock_vnpy_Trading/.venv/bin/python scripts/calibrate_eastmoney_thresholds.py --min-samples 384
StandardOutput=journal
StandardError=journal
TimeoutStopSec=60

[Install]
WantedBy=default.target
