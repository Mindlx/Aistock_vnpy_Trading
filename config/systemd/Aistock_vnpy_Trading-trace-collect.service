[Unit]
Description=Aistock_vnpy_Trading — 轨迹自动采集（兜底扫描未处理的 Oracle 会话）
Documentation=https://github.com/Mindlx/Aistock_vnpy_Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/bluekuma/workspace/Aistock_vnpy_Trading
ExecStart=/usr/bin/python3 /home/bluekuma/workspace/Aistock_vnpy_Trading/scripts/trace_auto_collect.py
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30

[Install]
WantedBy=default.target
