[Unit]
Description=Aistock_vnpy_Trading — 融合引擎日终分析（工作日 19:00，不含TA，使用13:00 TA结果）
Documentation=https://github.com/Mindlx/Aistock_vnpy_Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/bluekuma/workspace/Aistock_vnpy_Trading
EnvironmentFile=/home/bluekuma/workspace/Aistock_vnpy_Trading/.env
ExecStart=/home/bluekuma/workspace/Aistock_vnpy_Trading/.venv/bin/python scripts/run_daily.py
StandardOutput=append:/home/bluekuma/workspace/Aistock_vnpy_Trading/config/logs/fusion-cron.log
StandardError=append:/home/bluekuma/workspace/Aistock_vnpy_Trading/config/logs/fusion-cron.log
Restart=on-failure
RestartSec=60
TimeoutStopSec=600
